# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key
SUPABASE_SECRET_KEY=sb_secret_xxx                         # or the legacy "service_role" key — server only, never expose

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Embeddings for vector search (768 dims). Changing it means re-embedding: npm run cache:enrich -- --steps embed after clearing embeddings.
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# The coach makes several calls per message, so it starts on Flash Lite (15 requests a minute instead of 5).
COACH_MODEL=gemini-3.1-flash-lite
COACH_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash

# Set to "true" after enabling Google as a provider in Supabase Auth
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# USDA FoodData Central (free, public domain): https://fdc.nal.usda.gov/api-key-signup
# Without it the app uses DEMO_KEY (30 requests/hour), then falls back to AI.
USDA_API_KEY=

# Coach chat messages per user per 24 hours
CHAT_DAILY_LIMIT=30


# Optional: LaunchDarkly feature flags (Project settings → Environments → your environment).
# Flags: sign-in-users (who can use the app) and admin-users (who sees admin tools).
# Without these, everyone can sign in and nobody is an admin.
# The client-side ID is public by design; the SDK key is secret (server only).
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_ID=
LAUNCHDARKLY_SDK_KEY=

# Optional: sync logged meals to the Google Health app. Google Cloud Console → APIs & Services → Credentials
# (OAuth client type "Web application", redirect URI: https://YOUR-DOMAIN/api/google-health/callback).
# Scopes to enable on the consent screen: googlehealth.nutrition.writeonly (meals out) and
# googlehealth.activity_and_fitness.readonly (daily steps in).
# Without these the "Connect Google Health" card stays hidden. Server only, never expose the secret.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Optional: meal reminders (push notifications). Generate the key pair once with `npx web-push generate-vapid-keys`.
# The public key is shipped to browsers by design; the private key is secret (server only).
# REMINDERS_SECRET is any long random string (`openssl rand -hex 32`); pg_cron sends it back to /api/reminders/send. See README → Meal reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
REMINDERS_SECRET=
